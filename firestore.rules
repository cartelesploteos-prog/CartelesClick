rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.email == 'carteles.ploteos@gmail.com');
    }
    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Orders Collection
    match /orders/{orderId} {
      // Allow users to read/update their own orders using UID
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Allow creation ensuring the user sets their own UID
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Allow updates (restricted to owner or admin)
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      allow delete: if isAdmin();

      // Audit Logs Subcollection (Immutable history of order status and mutations)
      match /audit_logs/{logId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
      match /auditLogs/{logId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Top-level Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    
    // Materials (Public read, admin write)
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
